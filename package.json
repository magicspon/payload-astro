{
	"version": "0.0.0",
	"name": "spon",
	"private": true,
	"type": "module",
	"description": "Modern CMS platform built with Payload CMS, featuring UseSend email delivery and Plausible Analytics integration",
	"author": {
		"name": "David Stockley",
		"email": "hello@spon.io",
		"url": "https://spon.io"
	},
	"scripts": {
		"payload": "pnpm --filter=@spon/cms payload",
		"generate:types": "turbo generate:types --filter=@spon/cms",
		"generate:importmap": "turbo generate:importmap --filter=@spon/cms",
		"generate:db-schema": "turbo generate:db-schema --filter=@spon/cms",
		"seed": "turbo seed --filter=@spon/cms --",
		"create-stub": "turbo create-stub --filter=@spon/cms --",
		"preinstall": "npx only-allow pnpm",
		"build": "turbo build",
		"ci": "turbo ci",
		"start": "turbo start",
		"dev": "turbo dev",
		"dev:ui": "turbo --filter=@spon/ui storybook",
		"storybook": "turbo storybook --filter=@spon/web",
		"format": "prettier --write \"**/*.{ts,tsx,md,css}\"",
		"lint": "turbo lint",
		"typecheck": "turbo typecheck",
		"clean": "turbo clean; rm -rf node_modules",
		"new:component": "turbo gen component",
		"new:fn": "turbo gen fn",
		"new:hook": "turbo gen hook",
		"new:context": "turbo gen context",
		"test": "vitest",
		"test:ui": "vitest --ui",
		"test:run": "vitest run --passWithNoTests",
		"e2e": "playwright test",
		"e2e:ui": "playwright test --ui",
		"e2e:run": "playwright test --reporter=list",
		"e2e:ci": "CI=true playwright test --reporter=github",
		"e2e:install": "playwright install --with-deps",
		"e2e:report": "playwright show-report",
		"e2e:debug": "playwright test --debug",
		"e2e:visual": "playwright test e2e/visual-regression.spec.ts",
		"e2e:visual:update": "playwright test e2e/visual-regression.spec.ts --update-snapshots",
		"changeset": "changeset",
		"changeset version": "changeset version",
		"create-changeset": "node scripts/changeset.js",
		"db:studio": "drizzle-kit studio --config=apps/cms/drizzle.config.ts",
		"db:up": "docker compose up postgres -d",
		"db:down": "docker compose down --volumes --remove-orphans",
		"export-db": "tsx --env-file=.env ./scripts/export-db.ts",
		"export-db:prod": "tsx --env-file=.env ./scripts/export-prod-db.ts",
		"import-db": "tsx --env-file=.env ./scripts/import-db.ts",
		"clear-db": "tsx --env-file=.env ./scripts/clear-db.ts",
		"sync-secrets": "./scripts/sync-github-secrets.sh",
		"sync-s3": "./scripts/sync-s3-assets.sh",
		"sync-s3:dry-run": "./scripts/sync-s3-assets.sh --dry-run",
		"sync-db": "./scripts/sync-db-from-production.sh",
		"sync-db:dry-run": "./scripts/sync-db-from-production.sh --dry-run",
		"sync-db:restore": "./scripts/sync-db-from-production.sh --restore-from",
		"db:drop": "./scripts/drop-db.sh",
		"docker:dev": "docker compose up",
		"docker:dev:build": "docker compose up --build",
		"docker:dev:down": "docker compose down",
		"docker:dev:logs": "docker compose logs -f cms web",
		"docker:cms": "docker compose up cms -d",
		"docker:cms:down": "docker compose stop cms",
		"docker:cms:logs": "docker compose logs -f cms",
		"docker:web": "docker compose up web -d",
		"docker:web:down": "docker compose stop web",
		"docker:web:logs": "docker compose logs -f web",
		"docker:postgres": "docker compose up postgres -d",
		"docker:postgres:down": "docker compose stop postgres",
		"docker:rustfs": "docker compose up rustfs -d",
		"docker:rustfs:down": "docker compose stop rustfs",
		"docker:build": "./scripts/build-docker-app.sh cms",
		"docker:build:web": "./scripts/build-docker-app.sh web",
		"docker:run": "docker run -p 3000:3000 --env-file apps/cms/.env -e DATABASE_URL=postgres://postgres:postgres@host.docker.internal:35435/spon -e S3_ENDPOINT=http://host.docker.internal:9000 --add-host=host.docker.internal:host-gateway --name spon-payload-app --rm spon-payload:latest",
		"docker:run:web": "docker run -p 4321:4321 --env-file apps/web/.env --add-host=host.docker.internal:host-gateway --name spon-web-app --rm spon-web:latest",
		"docker:run:services": "docker compose up postgres rustfs plausible plausible_db plausible_events_db -d",
		"docker:run:services:down": "docker compose stop postgres rustfs plausible plausible_db plausible_events_db",
		"docker:stop": "docker compose down -v",
		"docker:clean": "docker compose down -v && docker system prune -f",
		"docker:exec": "docker compose exec cms",
		"docker:generate:types": "docker compose exec cms pnpm generate:types",
		"docker:generate:importmap": "docker compose exec cms pnpm generate:importmap",
		"docker:generate:db-schema": "docker compose exec cms pnpm generate:db-schema",
		"docker:payload": "docker compose exec cms pnpm payload",
		"docker:migrate": "docker compose exec cms pnpm payload migrate",
		"docker:migrate:create": "docker compose exec cms pnpm payload migrate:create",
		"docker:migrate:status": "docker compose exec cms pnpm payload migrate:status",
		"prepare": "husky"
	},
	"devDependencies": {
		"@changesets/cli": "^2.31.0",
		"@commitlint/cli": "^21.0.1",
		"@commitlint/config-conventional": "^21.0.1",
		"@playwright/test": "^1.60.0",
		"@spon/typescript-config": "workspace:*",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@total-typescript/ts-reset": "^0.6.1",
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"@turbo/gen": "^2.9.14",
		"@vitest/ui": "^4.1.7",
		"commitlint": "^21.0.1",
		"dotenv": "^17.4.2",
		"husky": "^9.1.7",
		"jsdom": "^29.1.1",
		"lint-staged": "^17.0.5",
		"oxlint": "^1.66.0",
		"prettier": "^3.8.3",
		"prettier-plugin-astro": "^0.14.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"tsx": "^4.22.3",
		"turbo": "^2.9.14",
		"typescript": "^6.0.3",
		"vite": "^7.3.3",
		"vitest": "^4.1.7"
	},
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@11.1.2",
	"dependencies": {
		"@vitest/browser-playwright": "^4.1.7",
		"cross-env": "^10.1.0",
		"drizzle-kit": "0.31.10",
		"stylelint": "^17.12.0",
		"stylelint-config-standard": "^40.0.0"
	}
}
