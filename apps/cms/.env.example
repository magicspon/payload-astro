# Database Configuration
# PostgreSQL connection string for Payload CMS
DATABASE_URL=

# Payload CMS Configuration
# Secret key used for encrypting sensitive data and signing tokens
PAYLOAD_SECRET=
# Bearer token for authenticating API requests to Payload
PAYLOAD_BEARER_TOKEN=

# S3 Storage Configuration
# S3-compatible storage settings for media uploads (RustFS, AWS S3, etc.)
S3_BUCKET=
S3_BUCKET_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# Preview Mode
# Secret token for enabling draft/preview functionality
PREVIEW_SECRET=

# Application URLs
# Frontend application URL
CLIENT_URL=
# CMS backend URL (server-side)
CMS_URL=
# CMS backend URL (exposed to client/browser)
NEXT_PUBLIC_CMS_URL=

# Dokploy Deployment Configuration
# Credentials for Dokploy container orchestration platform
DOKPLOY_APPLICATION_ID=
DOKPLOY_AUTH_TOKEN=
DOKPLOY_URL=

# Plausible Analytics Configuration
# Self-hosted privacy-friendly analytics platform
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=
PLAUSIBLE_API_KEY=
PLAUSIBLE_API_HOST=

# AWS Configuration
# AWS credentials for additional services (if needed beyond S3)
AWS_ACCESS_KEY=
AWS_SECRET_KEY=

# GitHub OAuth Configuration (Legacy)
# GitHub OAuth credentials for user authentication (consider migrating to Better Auth)
GITHUB_ID=
GITHUB_SECRET=

# Email Configuration (UseSend)
# Self-hosted transactional email delivery service
USE_SEND_API_KEY=
USE_SEND_URL=

# Better Auth Configuration
# Modern authentication library configuration
BETTER_AUTH_SECRET=
# GitHub OAuth credentials for Better Auth
GITHUB_AUTH_CLIENT_ID=
GITHUB_AUTH_CLIENT_SECRET=
