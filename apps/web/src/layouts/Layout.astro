---
import '~/styles/global.css'
import '~/styles/cookiebanner.css'
import styles from './layout.module.css'
import { ClientRouter } from 'astro:transitions'
import { Font } from 'astro:assets'
import { Setting } from '@spon/payload-types'
import { deepMerge } from '@spon/utils/deepMerge'
import { cn } from '@spon/ui/utils/cn'
import Header from '~/components/global/Header/Header.astro'
import Footer from '~/components/global/Footer/Footer.astro'
import { SEO, type Props as SeoProps } from 'astro-seo'
import { sdk } from '~/lib/payload'
import { parseSeo } from '~/utils/parseSeo'
import { TThemeProps } from '~/components/ui/Theme'

const isDev = import.meta.env.NODE_ENV === 'development'

const result = await sdk.findGlobal({
	slug: 'settings',
	select: {
		navigation: true,
		meta: true,
	},
})

type Props = {
	meta: Setting['meta']
	theme?: TThemeProps['theme']
	className?: string
}

const { meta, theme = 'dark' } = Astro.props

const seoProps: SeoProps = deepMerge(parseSeo(result.meta), parseSeo(meta))
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<Font cssVariable="--font-bitter" preload />
		<Font cssVariable="--font-raleway" preload />
		<SEO {...seoProps} />
		<!-- <script
			defer
			is:inline
			data-domain={env.PLAUSIBLE_DOMAIN}
			src={env.PLAUSIBLE_SCRIPT}></script> -->
		<ClientRouter />
	</head>
	<body data-theme={theme}>
		<Header theme={theme} />
		<slot name="hero" />
		<main data-theme={theme} class={styles.main}>
			<slot name="side" />
			<slot />
		</main>
		<Footer theme={theme} />

		{isDev && <div class="mq-debugger" />}

		<script>
			const supportsPopoverTarget =
				HTMLElement.prototype.hasOwnProperty('popover') &&
				'showPopover' in HTMLElement.prototype

			if (!supportsPopoverTarget) {
				let abort: AbortController

				document.addEventListener('astro:page-load', () => {
					abort = new AbortController()
					document.querySelectorAll('[popovertarget]').forEach((btn) => {
						btn.addEventListener(
							'click',
							() => {
								const targetId = btn.getAttribute('popovertarget')!
								const dialog = document.getElementById(
									targetId,
								) as HTMLDialogElement
								if (dialog) {
									dialog.open = !dialog.open
								}
							},
							{ signal: abort.signal },
						)
					})
				})
				document.addEventListener('astro:before-swap', () => abort.abort())
			}
		</script>
	</body>
</html>
